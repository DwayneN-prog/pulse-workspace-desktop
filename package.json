{
  "name": "pulse-workspace-desktop",
  "productName": "Pulse Workspace",
  "version": "0.2.0",
  "description": "Native Windows desktop application for Pulse Platform.",
  "author": "Pulse Platform",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DwayneN-prog/pulse-workspace-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/DwayneN-prog/pulse-workspace-desktop/issues"
  },
  "homepage": "https://github.com/DwayneN-prog/pulse-workspace-desktop",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "za.co.pulseworkspace.desktop",
    "copyright": "Copyright © 2026 Pulse Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "PulseWorkspaceSetup.exe",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulse Workspace",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "uninstallDisplayName": "${productName} ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "DwayneN-prog",
      "repo": "pulse-workspace-desktop"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
